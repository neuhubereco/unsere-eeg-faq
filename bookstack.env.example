# Konfiguration für bookstack_sync.py — als bookstack.env (chmod 600) ablegen.
# bookstack.env ist gitignored und darf NIE ins Repo.
#
# Auth = normaler Benutzer-Login (Session über den OIDC/Keycloak-Flow).
# Die Rolle braucht Bearbeiten-Rechte im Kapitel "FAQ (WhatsApp Zusammenfassung)".
# (API-Tokens funktionieren hier nicht — die Rolle hat keinen System-API-Zugriff.)
BOOKSTACK_USER=
BOOKSTACK_PASSWORD=
# Defaults (nur bei Bedarf ändern):
#BOOKSTACK_URL=https://docs.eegfaktura.at
#BOOKSTACK_BOOK=faq
#BOOKSTACK_CHAPTER=faq-whatsapp-zusammenfassung
#BOOKSTACK_INCLUDE_TOOL=1
