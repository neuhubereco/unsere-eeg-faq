# Konfiguration für bookstack_sync.py — als bookstack.env (chmod 600) ablegen.
# bookstack.env ist gitignored und darf NIE ins Repo.
#
# API-Token anlegen: docs.eegfaktura.at → Profilmenü → "Mein Account" → API-Tokens
# (Voraussetzung: die Rolle des Users braucht die Berechtigung "Zugriff auf System-API"
#  UND Bearbeiten-Rechte im Kapitel "FAQ (WhatsApp Zusammenfassung)" — beides via MatthiasM.)
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=
# Defaults (nur bei Bedarf ändern):
#BOOKSTACK_URL=https://docs.eegfaktura.at
#BOOKSTACK_CHAPTER_ID=43
#BOOKSTACK_INCLUDE_TOOL=1
